{
  "manifest_version": 3,
  "name": "Markusaller Comet Search Reuse",
  "version": "1.0.0",
  "description": "Uses one Comet tab for searches started from Markusaller.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
